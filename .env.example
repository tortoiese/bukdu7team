# docker-compose.yml 전용 환경변수. 실제 값을 채운 .env 파일은 커밋하지 않는다.
POSTGRES_PASSWORD=entry
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ENTRY_AI_MOCK=true
ENTRY_AI_PROVIDER=anthropic
ENTRY_AI_MODEL=claude-sonnet-5
ENTRY_AI_OPENAI_MODEL=gpt-4o
# 배포 후 실제 접속 도메인/IP로 바꾼다. 둘 다 같은 값(웹이 서빙되는 origin)을 가리킨다.
ENTRY_CORS_ORIGINS=http://localhost
ENTRY_WEB_ORIGIN=http://localhost
# D1/D2 운영자 화면(/entryadmin) 진입 비밀번호. 배포 시 반드시 기본값에서 바꾼다.
ENTRY_ADMIN_PASSWORD=entryadmin
# P3 방문 리캡에서 이메일로 저장 링크를 보낼 때 사용(https://resend.com). 비워두면 목업(로그만 남김)으로 동작.
RESEND_API_KEY=
ENTRY_MAIL_MOCK=true
ENTRY_MAIL_FROM=ENTRY <onboarding@resend.dev>
